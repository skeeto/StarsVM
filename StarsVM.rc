/* StarsVM.rc - the application manifest.
 *
 * The only thing this really has to say is that the process is DPI-unaware.
 * An unmanifested process is DPI-unaware by default today, so the window comes
 * out right either way - but a default is not a decision, and the default has
 * changed before.  Stars! computes every layout in raw pixels from a 1995
 * screen, so it wants the system to scale the whole window rather than hand it
 * a coordinate space it has never heard of.
 */

#include <windows.h>

1 RT_MANIFEST "StarsVM.manifest"

/* Generated by tools/mkicon.py from the game's own RT_GROUP_ICON.  It is a
   generated file rather than a checked-in one because the icon belongs to the
   game, not to this program; a build without stars.exe present gets a
   comment here instead and still links. */
#include "StarsVM_icon.rc"
